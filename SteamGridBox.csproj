<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SteamGridBox</AssemblyName>
    <RootNamespace>SteamGridBox</RootNamespace>
    <Version>1.4.1</Version>
    <PlatformTarget>x64</PlatformTarget>
    <GamePath Condition="'$(GamePath)' == ''">D:\SteamLibrary\steamapps\common\My Game Room</GamePath>
    <ModsPanelPath Condition="'$(ModsPanelPath)' == ''">C:\Users\Rusty\source\repos\ModsPanel\bin\Release\netstandard2.1\ModsPanel.dll</ModsPanelPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(GamePath)\BOXROOM_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="MelonLoader" HintPath="$(GamePath)\MelonLoader\net35\MelonLoader.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GamePath)\MelonLoader\net35\0Harmony.dll" Private="false" />
    <Reference Include="ModsPanel" HintPath="$(ModsPanelPath)" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GamePath)\BOXROOM_Data\Managed\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GamePath)\BOXROOM_Data\Managed\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GamePath)\BOXROOM_Data\Managed\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GamePath)\BOXROOM_Data\Managed\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GamePath)\BOXROOM_Data\Managed\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestModule" HintPath="$(GamePath)\BOXROOM_Data\Managed\UnityEngine.UnityWebRequestModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GamePath)\BOXROOM_Data\Managed\Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>
</Project>
